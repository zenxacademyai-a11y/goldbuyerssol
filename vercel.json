{
  "rewrites": [
    {
      "source": "/((?!api/|assets/|images/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(mp4|webm|webp|png|jpg|jpeg|gif|svg|ico|json|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
